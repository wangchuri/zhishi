# 知拾本地配置示例：复制为 config.yml 再按需修改（勿把真实密钥提交进仓库）
# 相对路径均以 backend/ 为基准；也可在设置页修改 MinerU 等项。
storage_dir: ./storage
image_base_dir: ./storage/images
database_url: sqlite:///./data/zhishi.db
max_concurrency: 1
question_gen_max_concurrency: 3
question_gen_max_pages: 30
# MinerU：local=本机 mineru-api；cloud=mineru.net
mineru_mode: local
mineru_api_token: ""
mineru_api_base: https://mineru.net
mineru_model_version: vlm
# PDF 解析策略：smart=可疑(公式/结构缺失)走 MinerU；all=全部 PDF 走 MinerU；scanned_only=仅扫描件
pdf_parse_policy: smart
# MinerU 独立安装目录（留空 = ~/.zhishi/mineru）；空闲多少秒后自动释放 mineru-api 进程
mineru_install_dir: ""
mineru_idle_seconds: 600

# ── 插件 ──────────────────────────────────────────────────
# 两种来源，都是本机单用户、不做沙箱（等同于自己 pip install）：
#
# 1) 内置插件（plugins/builtin/<id>/）：主推形态。能注册后端接口、Agent 工具、
#    钩子、提示词补充；给实体挂 extensions 后前端用内置渲染器画（发音按钮、
#    生词 chip、词典卡）。改完 POST /api/v1/system/plugins/reload 生效。
# 2) MCP server：逃生口，默认空。想接 Notion / Obsidian / 某个学校服务时加一行。
plugins:
  builtin:
    # 英语：英文题挂发音按钮（浏览器 TTS，离线可用）和生词 chip
    english: true
  mcp_servers: []
#
# MCP 配置示例（需要 node/npx 或远程服务时取消注释）：
#   mcp_servers:
#     - id: files
#       type: stdio
#       command: npx
#       args: ["-y", "@modelcontextprotocol/server-filesystem", "D:/notes"]
#       enabled: false
#     - id: school
#       type: http
#       url: https://example.com/mcp
#       headers:
#         Authorization: "Bearer xxx"
#       enabled: false
#       timeout: 15
